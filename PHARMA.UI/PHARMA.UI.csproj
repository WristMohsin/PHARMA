<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PHARMA.UI</RootNamespace>
    <AssemblyName>PHARMA</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <ProjectReference Include="..\PHARMA.Services\PHARMA.Services.csproj" />
    <ProjectReference Include="..\PHARMA.Models\PHARMA.Models.csproj" />
    <ProjectReference Include="..\PHARMA.Common\PHARMA.Common.csproj" />
    <ProjectReference Include="..\PHARMA.DataAccess\PHARMA.DataAccess.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
