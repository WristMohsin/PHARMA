<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="PHARMA"
         connectionString="Driver={SQL Server};Server=localhost;Database=PharmaZ;Trusted_Connection=Yes;"
         providerName="System.Data.Odbc" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
</configuration>
